# CampusOS Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# ==============================================================================
# Supabase Relational Database & Storage Configuration
# ==============================================================================
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

# ==============================================================================
# Web Platform Security
# ==============================================================================
JWT_SECRET=your_super_secret_jwt_signing_key_change_me_in_production

# ==============================================================================
# Multi-Tier LLM Gateway Configuration
# ==============================================================================
# Primary Groq API Key
GROQ_API_KEY=gsk_your_primary_groq_api_key

# Secondary / Backup Groq API Key (for rate limit failover)
GROQ_API_KEY0=gsk_your_secondary_groq_api_key

# Tertiary Fallback: Google Gemini API Key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key

# Optional Model Overrides
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO
